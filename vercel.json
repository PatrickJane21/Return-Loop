{
  "services": {
    "returnloop": {
      "root": "artifacts/returnloop",
      "framework": "vite"
    },
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "returnloop"
      }
    }
  ]
}
